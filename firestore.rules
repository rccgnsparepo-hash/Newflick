rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Primitive helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Connection test collection
    match /test/{document} {
      allow read, write: if true;
    }

    // 1. Users collection
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if isSignedIn() && request.auth.uid == userId;
        
      match /{allSubcollections=**} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // 2. Feed Posts collection
    match /posts/{postId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn() && (resource == null || resource.data.authorId == request.auth.uid);
  
      match /{allSubcollections=**} {
        allow read, write: if isSignedIn();
      }
    }

    // 3. Direct Chats and Group Chats metadata
    match /chats/{chatId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isSignedIn();
         
      // Subcollection messages
      match /messages/{messageId} {
        allow read, create, update, delete: if isSignedIn();

        match /{allSubcollections=**} {
          allow read, write: if isSignedIn();
        }
      }

      match /{allSubcollections=**} {
        allow read, write: if isSignedIn();
      }
    }

    // 4. In-App Notifications
    match /notifications/{notificationId} {
      allow read, create, update, delete: if isSignedIn();
    }

    // 5. Stories collection
    match /stories/{storyId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
        
      match /{allSubcollections=**} {
        allow read, write: if isSignedIn();
      }
    }

    // 6. Feedbacks collection
    match /feedbacks/{feedbackId} {
      allow read, create, update: if true;
    }

    // 7. Calls collection
    match /calls/{callId} {
      allow read, write: if isSignedIn();
    }

    // 8. Broadcast News collection
    match /news/{newsId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }
  }
}
