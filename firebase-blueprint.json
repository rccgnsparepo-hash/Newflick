{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Public user profile details for social discovery, identity verification, and presence.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique user ID from Auth" },
        "displayName": { "type": "string", "description": "Display name" },
        "photoURL": { "type": "string", "description": "Avatar photo URL" },
        "email": { "type": "string", "description": "User email address" },
        "status": { "type": "string", "enum": ["online", "offline"], "description": "User realtime presence state" },
        "publicKey": { "type": "string", "description": "Public key for end-to-end encryption key exchange" },
        "bio": { "type": "string", "description": "Short user biography" },
        "soundEnabled": { "type": "boolean", "description": "Notification sound preference" },
        "lastSeen": { "type": "string", "format": "date-time", "description": "Last heartbeat timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Profile modification timestamp" }
      },
      "required": ["uid", "displayName", "email", "status", "updatedAt"]
    },
    "PrivateInfo": {
      "title": "Private User Info",
      "description": "Private sensitive user details isolated for security and privacy.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "description": "Private verified email address" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Account registration timestamp" }
      },
      "required": ["email", "createdAt"]
    },
    "Chat": {
      "title": "Direct Conversation Bridge",
      "description": "Conversation synchronization metadata between user devices.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Chat session ID" },
        "participantIds": { "type": "array", "description": "Array of participant user IDs" },
        "lastMessage": { "type": "string", "description": "Last message preview snippet" },
        "lastMessageAt": { "type": "string", "format": "date-time", "description": "Timestamp of last message" },
        "typing": { "type": "object", "description": "Realtime map of participant ID to typing state" }
      },
      "required": ["id", "participantIds", "lastMessage", "lastMessageAt"]
    },
    "Message": {
      "title": "Message Envelope",
      "description": "Direct message transfer envelope between user endpoints.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Message document ID" },
        "senderId": { "type": "string", "description": "Sender user ID" },
        "receiverId": { "type": "string", "description": "Receiver user ID" },
        "participantIds": { "type": "array", "description": "Sorted identifiers of conversation participants" },
        "plainText": { "type": "string", "description": "Readable message text content" },
        "encryptedText": { "type": "string", "description": "Encrypted message payload" },
        "encryptedKey": { "type": "string", "description": "Encrypted session key" },
        "senderEncryptedKey": { "type": "string", "description": "Sender encrypted session key for history recovery" },
        "senderDisplayName": { "type": "string", "description": "Display name of sender" },
        "expiresAt": { "type": "string", "format": "date-time", "description": "Optional message self-destruct timestamp" },
        "read": { "type": "boolean", "description": "Delivery read confirmation flag" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Message creation timestamp" }
      },
      "required": ["id", "senderId", "receiverId", "participantIds", "createdAt"]
    },
    "Reaction": {
      "title": "Message Reaction",
      "description": "Emoji reaction on a specific message.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "User ID of the reacting participant" },
        "emoji": { "type": "string", "description": "Selected emoji character" },
        "userId": { "type": "string", "description": "User ID of the reacting participant" },
        "userName": { "type": "string", "description": "Display name of the reacting participant" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp of reaction" }
      },
      "required": ["id", "emoji", "userId", "userName", "createdAt"]
    },
    "Presence": {
      "title": "Realtime Presence",
      "description": "Realtime heartbeat status and typing indicators for active endpoints.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "User ID" },
        "status": { "type": "string", "enum": ["online", "offline"], "description": "Active connection status" },
        "lastActive": { "type": "string", "format": "date-time", "description": "Heartbeat timestamp" },
        "platform": { "type": "string", "description": "Active client platform (web, android, electron, linux)" }
      },
      "required": ["userId", "status", "lastActive"]
    },
    "Notification": {
      "title": "In-App Push Notification",
      "description": "Real-time push notifications dispatched between user devices.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Notification ID" },
        "receiverId": { "type": "string", "description": "Notification recipient user ID" },
        "senderName": { "type": "string", "description": "Initiator user's display name" },
        "type": { "type": "string", "enum": ["message", "call", "like"], "description": "Notification category" },
        "title": { "type": "string", "description": "Alert notification title" },
        "body": { "type": "string", "description": "Alert notification body text" },
        "read": { "type": "boolean", "description": "Notification read status" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Notification trigger time" }
      },
      "required": ["id", "receiverId", "senderName", "type", "title", "body", "read", "createdAt"]
    },
    "Call": {
      "title": "WebRTC Call Session",
      "description": "Realtime WebRTC signaling and active call session state.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique call session ID" },
        "callerId": { "type": "string", "description": "Caller user ID" },
        "callerName": { "type": "string", "description": "Caller display name" },
        "receiverId": { "type": "string", "description": "Recipient user ID" },
        "status": { "type": "string", "enum": ["calling", "connected", "declined", "ended"], "description": "Call status" },
        "type": { "type": "string", "enum": ["voice", "video"], "description": "Call stream type" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Call initialization timestamp" }
      },
      "required": ["id", "callerId", "callerName", "receiverId", "status", "type", "createdAt"]
    },
    "Device": {
      "title": "User Device Registration",
      "description": "Registered client device coordination metadata for local-first synchronization.",
      "type": "object",
      "properties": {
        "deviceId": { "type": "string", "description": "Unique device ID" },
        "userId": { "type": "string", "description": "Owner user ID" },
        "deviceName": { "type": "string", "description": "Device name descriptor" },
        "platform": { "type": "string", "enum": ["web", "android", "electron", "linux"], "description": "Device platform" },
        "lastSyncAt": { "type": "string", "format": "date-time", "description": "Last synchronization timestamp" }
      },
      "required": ["deviceId", "userId", "deviceName", "platform", "lastSyncAt"]
    },
    "News": {
      "title": "Broadcast News Alert",
      "description": "System broadcasted cybersecurity alert and platform news item.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "News alert title" },
        "category": { "type": "string", "description": "News alert category" },
        "impactLevel": { "type": "string", "description": "Severity level of news" },
        "summary": { "type": "string", "description": "Short description of the alert" },
        "body": { "type": "string", "description": "Full content body text" },
        "source": { "type": "string", "description": "Signal source publisher" },
        "url": { "type": "string", "description": "Reference URL or deep link" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp of broadcast dispatch" }
      },
      "required": ["title", "category", "impactLevel", "summary", "body", "source", "createdAt"]
    },
    "Post": {
      "title": "Social Feed Post",
      "description": "Feed post with media attachments, text content, and interaction counters.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique post identifier" },
        "userId": { "type": "string", "description": "Author user ID" },
        "userDisplayName": { "type": "string", "description": "Author display name" },
        "content": { "type": "string", "description": "Post text content" },
        "mediaUrl": { "type": "string", "description": "Optional attached media URL" },
        "likesCount": { "type": "number", "description": "Total like count" },
        "commentsCount": { "type": "number", "description": "Total comment count" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Post creation timestamp" }
      },
      "required": ["id", "userId", "content", "createdAt"]
    },
    "Story": {
      "title": "Ephemeral Story",
      "description": "Short-lived media story snippet.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique story identifier" },
        "userId": { "type": "string", "description": "Author user ID" },
        "mediaUrl": { "type": "string", "description": "Story media asset URL" },
        "caption": { "type": "string", "description": "Story caption text" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Story timestamp" }
      },
      "required": ["id", "userId", "mediaUrl", "createdAt"]
    },
    "DeviceAuthorization": {
      "title": "Device Login Authorization Request",
      "description": "Multi-device account sync lock authorization request and pairing handshake.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique auth request identifier" },
        "userId": { "type": "string", "description": "Target account user ID" },
        "deviceId": { "type": "string", "description": "Requesting client device ID" },
        "deviceName": { "type": "string", "description": "Requesting device name" },
        "deviceType": { "type": "string", "enum": ["desktop", "mobile", "web"], "description": "Client device form factor" },
        "verificationCode": { "type": "string", "description": "6-digit authorization PIN code" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected", "expired"], "description": "Request status" },
        "syncPin": { "type": "string", "description": "Vault relay synchronization PIN" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Request timestamp" }
      },
      "required": ["id", "userId", "deviceId", "verificationCode", "status", "syncPin", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Public user directory for discovery and identity."
    },
    "/users/{userId}/private/info": {
      "schema": "PrivateInfo",
      "description": "Isolated private user information."
    },
    "/posts/{postId}": {
      "schema": "Post",
      "description": "Public social feed posts and broadcasts."
    },
    "/stories/{storyId}": {
      "schema": "Story",
      "description": "Ephemeral stories and media vignettes."
    },
    "/device_authorizations/{authId}": {
      "schema": "DeviceAuthorization",
      "description": "Multi-device sign-in approval requests and pairing locks."
    },
    "/chats/{chatId}": {
      "schema": "Chat",
      "description": "Direct conversation synchronization metadata."
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Direct message transfer envelopes."
    },
    "/chats/{chatId}/messages/{messageId}/message_reactions/{userId}": {
      "schema": "Reaction",
      "description": "Message emoji reactions."
    },
    "/presence/{userId}": {
      "schema": "Presence",
      "description": "Realtime endpoint presence and heartbeat status."
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "Real-time push and in-app alerts."
    },
    "/calls/{callId}": {
      "schema": "Call",
      "description": "WebRTC call signaling and session states."
    },
    "/user_devices/{deviceId}": {
      "schema": "Device",
      "description": "Registered user endpoints for device-to-device coordination."
    },
    "/news/{newsId}": {
      "schema": "News",
      "description": "Broadcast news and system alerts."
    }
  }
}
