{
  "name": "flick-lan-server",
  "version": "1.0.0",
  "description": "Flick Offline-First Hybrid LAN Infrastructure Server",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs'); fs.mkdirSync('dist/dashboard', {recursive:true}); fs.copyFileSync('src/dashboard/dashboard.html', 'dist/dashboard/dashboard.html'); fs.copyFileSync('src/dashboard/dashboardApp.js', 'dist/dashboard/dashboardApp.js');\"",
    "start": "electron .",
    "dev": "tsc && electron .",
    "package": "tsc && electron-builder"
  },
  "dependencies": {
    "body-parser": "^1.20.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/ws": "^8.5.14",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "typescript": "~5.8.2"
  }
}
