{
  "name": "flick",
  "productName": "Flick",
  "version": "1.0.0",
  "description": "Flick — Encrypted Chat by Faratech",
  "author": "Faratech",
  "main": "main.js",
  "scripts": {
    "build:win": "electron-builder --win"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "adm-zip": "^0.5.16"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "faratech.flick",
    "productName": "Flick",
    "copyright": "Copyright © 2025 Faratech",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      { "from": "react-dist", "to": "react-dist" },
      { "from": "build/icon.ico", "to": "icon.ico" },
      { "from": "build/icon.png", "to": "icon.png" },
      { "from": "build/icon-tray.png", "to": "icon-tray.png" }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "artifactName": "Flick-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Flick"
    },
    "publish": {
      "provider": "github",
      "owner": "rccgnsparepo-hash",
      "repo": "Gi",
      "releaseType": "release"
    }
  }
}
